# Core database (SQLite remains the default until a verified PostgreSQL cutover)
DATABASE_URL="file:./prisma/netaj.db"

# Generate unique high-entropy values in the production secret manager.
AUTH_BOOTSTRAP_TOKEN="replace-with-one-time-bootstrap-token"
MFA_ENCRYPTION_KEY="replace-with-mfa-encryption-key"
INTEGRATION_ENCRYPTION_KEY="replace-with-integration-encryption-key"

# Private attachment storage: local or s3
ATTACHMENT_STORAGE_PROVIDER="local"
ATTACHMENT_STORAGE_DIR="./storage/attachments"
# S3_ENDPOINT="https://s3.example.com"
# S3_BUCKET="netaj-private"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="replace-me"
# S3_SECRET_ACCESS_KEY="replace-me"

# Independent worker tuning
BACKGROUND_WORKER_POLL_MS="2000"
BACKGROUND_WORKER_LEASE_MS="300000"

# Non-destructive PostgreSQL rehearsal only. The target must be empty.
# SQLITE_SOURCE_PATH="prisma/netaj.db"
# POSTGRES_DATABASE_URL="postgresql://user:password@host:5432/netaj_rehearsal"
# POSTGRES_SSL="1"
# POSTGRES_SSL_REJECT_UNAUTHORIZED="1"
# ALLOW_POSTGRES_MIGRATION="1"

# Keep disabled in production except during an explicitly controlled legacy operation.
NETAJ_LEGACY_CONTEXT="0"
ALLOW_DATABASE_BACKUP_DOWNLOAD="0"

# NETAJ ONE live LLM provider (required for conversational ASK requests).
# No credentials means /api/assistant ASK returns ASSISTANT_PROVIDER_UNAVAILABLE;
# the ERP does not fall back to unrelated dashboard statistics.
# ASSISTANT_LLM_PROVIDER="openai-compatible"
# ASSISTANT_LLM_URL="https://api.openai.com/v1/chat/completions"
# ASSISTANT_LLM_API_KEY="replace-in-secret-manager"
# ASSISTANT_LLM_MODEL="gpt-4o-mini"
# Alternatively set OPENAI_API_KEY, OPENAI_BASE_URL and OPENAI_MODEL.
