  fxRevaluationReversal FxRevaluation?        @relation("FxRevaluationReversalJournal")

  @@unique([referenceType, referenceId])
  @@index([entryDate])
  @@index([tenantId, companyId])
}

model JournalEntryLine {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  journalEntryId Int

  accountCode String
  accountName String
  accountId   Int?

  debit                   Decimal @default(0)
  credit                  Decimal @default(0)
  transactionDebit        Decimal @default(0)
  transactionCredit       Decimal @default(0)
  transactionCurrencyCode String  @default("SAR")
  exchangeRate            Decimal @default(1)

  partyId      Int?
  costCenter   String?
