  @@index([partyId])
  @@index([sourceOrderId])
  @@index([projectId, costCodeId])
  @@index([tenantId, companyId, invoiceDate, status])
  @@index([tenantId, companyId, partyId, dueDate])
  @@index([tenantId, companyId])
}

model SaleItem {
