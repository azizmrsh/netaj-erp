  functionalCurrencyCode  String    @default("SAR")
  exchangeRate            Decimal   @default(1)
  rateDate                DateTime?
  totalTransactionDebit   Decimal   @default(0)
  totalTransactionCredit  Decimal   @default(0)
  postedAt                DateTime?
  cancelledAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines                 JournalEntryLine[]
  financialVoucher      FinancialVoucher?
  expense               Expense?
  revenue               Revenue?
