  checksumSha256  String
  databaseVersion String?
  status          String    @default("VERIFIED")
  createdBy       Int?
  createdAt       DateTime  @default(now())
  verifiedAt      DateTime?
  company         Company   @relation(fields: [companyId], references: [id])

  @@unique([tenantId, companyId, backupNumber])
  @@index([tenantId, companyId, createdAt])
}

model BackgroundJob {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @default(1)
  companyId      Int       @default(1)
  jobNumber      String
  jobType        String
  status         String    @default("PENDING")
  priority       Int       @default(100)
  payloadJson    String    @default("{}")
  resultJson     String?
  idempotencyKey String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  scheduledAt    DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  nextRetryAt    DateTime?
  lastError      String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id])

  @@unique([tenantId, companyId, jobNumber])
  @@unique([tenantId, companyId, jobType, idempotencyKey])
  @@index([tenantId, companyId, status, scheduledAt, priority])
  @@index([tenantId, companyId, jobType, createdAt])
}

model TenantMembership {
  id               Int      @id @default(autoincrement())
  tenantId         Int
  userId           Int
  defaultCompanyId Int?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  user      PlatformUser     @relation(fields: [userId], references: [id])
  roles     MembershipRole[]
  companies CompanyAccess[]
  sessions  AuthSession[]

  @@unique([tenantId, userId])
  @@index([userId])
}

model CompanyAccess {
  membershipId Int
  companyId    Int
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([membershipId, companyId])
  @@index([companyId])
}

model AuthSession {
  id           String    @id
  tokenHash    String    @unique
  userId       Int
  membershipId Int
  companyId    Int
  expiresAt    DateTime
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user       PlatformUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([membershipId, companyId])
  @@index([expiresAt, revokedAt])
}

model Role {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  companyId Int?
  code      String
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  company     Company?         @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId])
}

model Permission {
  key         String   @id
  moduleKey   String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([moduleKey])
}

model RolePermission {
  roleId        Int
  permissionKey String
  granted       Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
}

model MembershipRole {
  membershipId Int
  roleId       Int

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}
