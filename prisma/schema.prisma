generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ======================================================
// NETAJ ERP
// Core Database Schema - Phase 1
// ======================================================

// ======================================================
// ENTITIES
// العميل / المورد / الاثنين معاً
// ======================================================

model Party {
  sales     Sale[]
  purchases Purchase[]
  id        Int        @id @default(autoincrement())
  tenantId  Int        @default(1)
  companyId Int        @default(1)

  nameAr String
  nameEn String?

  unifiedNumber String? @unique
  vatNumber     String?

  telephone String?
  email     String?
  bankName  String?
  iban      String?

  isCustomer Boolean @default(false)
  isSupplier Boolean @default(false)

  isActive Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address PartyAddress?

  stockAccounts        PartyStockAccount[]
  stockMovements       StockMovement[]
  transportTrips       TransportTrip[]
  businessDocuments    BusinessDocument[]
  financialVouchers    FinancialVoucher[]
  factoryTransactions  FactoryTransaction[]
  factoryFeeRates      FactoryFeeRate[]
  creditDebitNotes     CreditDebitNote[]
  projects             Project[]
  subcontractContracts SubcontractorContract[]

  notesDocuments DeliveryReceiptNote[]

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, iban])
}

// ======================================================
// NATIONAL ADDRESS
// العنوان الوطني
// ======================================================

model PartyAddress {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  partyId Int @unique

  buildingNumber  String?
  street          String?
  secondaryNumber String?
  district        String?
  city            String?
  postalCode      String?
  region          String?
  shortAddress    String?
  mapLink         String?

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId])
}

// ======================================================
// ITEM CATEGORIES
// تصنيفات المواد
// ======================================================

model ItemCategory {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  nameAr String
  nameEn String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@index([tenantId, companyId])
}

// ======================================================
// UNITS
// الوحدات
// طن / كجم / لتر / قطعة / برميل
// ======================================================

model Unit {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  code String @unique

  nameAr String
  nameEn String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@index([tenantId, companyId])
}

// ======================================================
// ITEMS / MATERIALS
// المواد والمنتجات
// ======================================================

model Item {
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  id            Int            @id @default(autoincrement())
  tenantId      Int            @default(1)
  companyId     Int            @default(1)

  code String @unique

  nameAr String
  nameEn String?

  categoryId Int?
  unitId     Int

  specification   String?
  manufacturer    String?
  countryOfOrigin String?
  batchNumber     String?

  costPrice Decimal @default(0)
  salePrice Decimal @default(0)

  vatRate Decimal @default(15)

  minimumStock Decimal @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ItemCategory? @relation(fields: [categoryId], references: [id])

  unit Unit @relation(fields: [unitId], references: [id])

  companyStock CompanyStock?

  partyStocks PartyStockAccount[]

  stockMovements        StockMovement[]
  transportTrips        TransportTrip[]
  businessDocumentLines BusinessDocumentLine[]

  noteItems            DeliveryReceiptNoteItem[]
  factoryTransactions  FactoryTransaction[]
  factoryFeeRates      FactoryFeeRate[]
  factoryFuelMovements FactoryFuelMovement[]
  externalTrades       ExternalTrade[]
  externalLinkedCosts  ExternalLinkedCost[]
  factoryTargets       FactoryProductionTarget[]
  projectBoqItems      ProjectBoqItem[]
  projectProgress      ProjectProgress[]
  projectBilling       Project[]                 @relation("ProjectBillingItem")
  subcontractBilling   SubcontractorContract[]   @relation("SubcontractBillingItem")

  @@index([tenantId, companyId])
}

// ======================================================
// COMPANY MAIN STOCK
// مخزون الشركة الرئيسي
// ======================================================

model CompanyStock {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  itemId Int @unique

  quantity Decimal @default(0)

  averageCost Decimal @default(0)

  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId])
}

// ======================================================
// CUSTOMER / PARTY STOCK
// مخزون العميل المستقل
//
// مهم:
// الرصيد يمكن أن يصبح سالباً.
// النظام سيحذر المستخدم ولكنه لا يمنع العملية.
// ======================================================

model PartyStockAccount {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  partyId Int
  itemId  Int

  quantity     Decimal @default(0)
  averageValue Decimal @default(0)

  updatedAt DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([partyId, itemId])
  @@index([tenantId, companyId])
}

// ======================================================
// STOCK MOVEMENTS
// حركة المخزون
//
// ownershipType:
//
// COMPANY
// CUSTOMER
//
// movementType:
//
// OPENING
// RECEIPT
// DELIVERY
// PURCHASE
// SALE
// TRANSFER_IN
// TRANSFER_OUT
// PROCESSING_IN
// PROCESSING_OUT
// ADJUSTMENT
// ======================================================

model StockMovement {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  movementNumber String @unique

  movementDate DateTime @default(now())

  itemId  Int
  partyId Int?

  ownershipType String
  movementType  String

  quantityIn  Decimal @default(0)
  quantityOut Decimal @default(0)

  unitCost   Decimal @default(0)
  totalValue Decimal @default(0)

  balanceAfter Decimal?

  referenceType   String?
  referenceId     Int?
  referenceNumber String?

  projectId    Int?
  costCenterId Int?
  costCodeId   Int?

  notes String?

  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])

  party Party? @relation(fields: [partyId], references: [id])

  factoryFuelMovement FactoryFuelMovement?
  project             Project?             @relation(fields: [projectId], references: [id])
  projectCostCenter   CostCenter?          @relation(fields: [costCenterId], references: [id])
  costCode            CostCode?            @relation(fields: [costCodeId], references: [id])

  @@index([movementDate])
  @@index([itemId])
  @@index([partyId])
  @@index([projectId, costCodeId])
  @@index([tenantId, companyId, movementDate, itemId, ownershipType])
  @@index([tenantId, companyId])
}

// ======================================================
// RECEIPT / DELIVERY NOTES
//
// سند استلام
// سند تسليم
//
// لا توجد أسعار في السند.
// ======================================================

model DeliveryReceiptNote {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  noteNumber String @unique

  noteType String
  noteDate DateTime @default(now())

  partyId          Int
  sourceDocumentId Int?
  projectId        Int?
  costCenterId     Int?
  costCodeId       Int?

  // COMPANY or PARTY. This determines which ownership ledger is affected
  // when the document is posted.
  stockOwnership String @default("PARTY")

  invoiceNumber   String?
  orderNumber     String?
  referenceNumber String?

  // ------------------------------------------
  // Transport Method
  //
  // COMPANY
  // CUSTOMER
  // EXTERNAL
  // ------------------------------------------

  transportMethod String?

  truckId  Int?
  driverId Int?

  carrierName String?

  vehiclePlate String?

  driverName     String?
  driverIdNumber String?
  driverPhone    String?

  source String?

  loadingPoint   String?
  unloadingPoint String?

  status String @default("DRAFT")

  stockPostedAt DateTime?
  cancelledAt   DateTime?

  notes String?

  // ------------------------------------------
  // Signatures
  // ------------------------------------------

  recipientName       String?
  recipientSignature  String?
  recipientSignedAt   DateTime?
  purchasingName      String?
  purchasingSignature String?
  purchasingSignedAt  DateTime?
  warehouseName       String?
  warehouseSignature  String?
  warehouseSignedAt   DateTime?
  accountantName      String?
  accountantSignature String?
  accountantSignedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party             Party             @relation(fields: [partyId], references: [id])
  sourceDocument    BusinessDocument? @relation(fields: [sourceDocumentId], references: [id])
  project           Project?          @relation(fields: [projectId], references: [id])
  projectCostCenter CostCenter?       @relation(fields: [costCenterId], references: [id])
  costCode          CostCode?         @relation(fields: [costCodeId], references: [id])

  truck  Truck?  @relation(fields: [truckId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  items            DeliveryReceiptNoteItem[]
  trip             TransportTrip?
  salesInvoices    Sale[]
  purchaseInvoices Purchase[]

  @@index([noteDate])
  @@index([partyId])
  @@index([sourceDocumentId])
  @@index([projectId, costCodeId])
  @@index([tenantId, companyId])
}

// ======================================================
// RECEIPT / DELIVERY NOTE ITEMS
//
// بدون أسعار
// ======================================================

model DeliveryReceiptNoteItem {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  noteId Int
  itemId Int

  sequence Int

  description   String?
  materialGrade String?
  orderNumber   String?

  quantity Decimal
  weight   Decimal?

  note DeliveryReceiptNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  item Item @relation(fields: [itemId], references: [id])

  @@index([noteId])
  @@index([itemId])
  @@index([tenantId, companyId])
}

// ======================================================
// TRANSPORT MODULE
// نظام النقل
// ======================================================

model Truck {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @default(1)
  companyId   Int      @default(1)
  plateNumber String   @unique
  truckType   String?
  model       String?
  modelYear   Int?
  trailerType String?
  capacity    Decimal?
  status      String   @default("ACTIVE")

  fuelType         String?
  fuelConsumption  Decimal? // liters per 100 km
  fuelPrice        Decimal?
  maintenancePerKm Decimal?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     TruckDocument[]
  trips         TransportTrip[]
  deliveryNotes DeliveryReceiptNote[]

  @@index([tenantId, companyId])
}

// ======================================================
// TRUCK DOCUMENTS
// وثائق الشاحنات
// ======================================================

model TruckDocument {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)
  truckId   Int

  documentType   String
  documentNumber String?

  issueDate  DateTime?
  expiryDate DateTime?

  attachmentUrl String?
  notes         String?

  createdAt DateTime @default(now())

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@index([truckId])
  @@index([expiryDate])
  @@index([tenantId, companyId])
}

// ======================================================
// DRIVERS
// السائقون
// ======================================================

model Driver {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  name        String
  idNumber    String? @unique
  phone       String?
  nationality String?

  licenseNumber String?
  licenseExpiry DateTime?

  passportNumber String?
  passportExpiry DateTime?

  driverCardNumber String?
  driverCardExpiry DateTime?

  status     String  @default("ACTIVE")
  notes      String?
  employeeId Int?    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     DriverDocument[]
  trips         TransportTrip[]
  deliveryNotes DeliveryReceiptNote[]
  employee      Employee?             @relation(fields: [employeeId], references: [id])

  @@index([tenantId, companyId])
}

model Employee {
  id                 Int       @id @default(autoincrement())
  tenantId           Int       @default(1)
  companyId          Int       @default(1)
  employeeNumber     String    @unique
  nameAr             String
  nameEn             String?
  idNumber           String?   @unique
  nationality        String?
  dateOfBirth        DateTime?
  phone              String?
  email              String?
  address            String?
  department         String?
  jobTitle           String?
  hireDate           DateTime?
  managerId          Int?
  contractType       String?
  basicSalary        Decimal   @default(0)
  housingAllowance   Decimal   @default(0)
  transportAllowance Decimal   @default(0)
  otherAllowance     Decimal   @default(0)
  bankName           String?
  iban               String?
  costCenter         String?
  status             String    @default("ACTIVE")
  idExpiry           DateTime?
  contractExpiry     DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  manager       Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates  Employee[]         @relation("EmployeeManager")
  driver        Driver?
  attendance    AttendanceRecord[]
  payrollLines  PayrollLine[]
  advances      EmployeeAdvance[]
  leaveRequests LeaveRequest[]

  @@index([department])
  @@index([status])
  @@index([tenantId, companyId])
}

model ExternalWorker {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @default(1)
  companyId        Int       @default(1)
  workerNumber     String    @unique
  name             String
  affiliatedEntity String?
  role             String?
  idNumber         String?
  phone            String?
  startDate        DateTime?
  endDate          DateTime?
  wage             Decimal   @default(0)
  paymentMethod    String?
  costCenter       String?
  status           String    @default("ACTIVE")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  costs ExternalWorkerCost[]

  @@index([tenantId, companyId])
}

model AttendanceRecord {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @default(1)
  companyId      Int      @default(1)
  employeeId     Int
  attendanceDate DateTime
  status         String
  workHours      Decimal  @default(0)
  overtimeHours  Decimal  @default(0)
  fridayHours    Decimal  @default(0)
  checkIn        String?
  checkOut       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@index([tenantId, companyId])
}

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @default(1)
  companyId  Int      @default(1)
  employeeId Int
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  status     String   @default("SUBMITTED")
  reason     String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([startDate, endDate])
  @@index([tenantId, companyId])
}

model EmployeeAdvance {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1)
  companyId       Int      @default(1)
  advanceNumber   String   @unique
  employeeId      Int
  advanceDate     DateTime @default(now())
  amount          Decimal
  recoveredAmount Decimal  @default(0)
  remainingAmount Decimal
  bankAccountId   Int
  journalEntryId  Int?     @unique
  status          String   @default("OPEN")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id])
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([employeeId])
  @@index([tenantId, companyId])
}

model PayrollRun {
  id              Int       @id @default(autoincrement())
  tenantId        Int       @default(1)
  companyId       Int       @default(1)
  payrollNumber   String    @unique
  year            Int
  month           Int
  status          String    @default("DRAFT")
  totalGross      Decimal   @default(0)
  totalDeductions Decimal   @default(0)
  totalNet        Decimal   @default(0)
  journalEntryId  Int?      @unique
  postedAt        DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines        PayrollLine[]
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@unique([year, month])
  @@index([tenantId, companyId])
}

model PayrollLine {
  id                 Int      @id @default(autoincrement())
  tenantId           Int      @default(1)
  companyId          Int      @default(1)
  payrollRunId       Int
  employeeId         Int
  basicSalary        Decimal  @default(0)
  housingAllowance   Decimal  @default(0)
  transportAllowance Decimal  @default(0)
  otherAllowances    Decimal  @default(0)
  normalWage         Decimal  @default(0)
  overtimeHours      Decimal  @default(0)
  overtimeValue      Decimal  @default(0)
  fridayHours        Decimal  @default(0)
  fridayValue        Decimal  @default(0)
  absenceDeduction   Decimal  @default(0)
  penalties          Decimal  @default(0)
  advances           Decimal  @default(0)
  otherDeductions    Decimal  @default(0)
  grossSalary        Decimal  @default(0)
  totalDeductions    Decimal  @default(0)
  netSalary          Decimal  @default(0)
  paymentStatus      String   @default("DUE")
  paidAmount         Decimal  @default(0)
  projectId          Int?
  costCenterId       Int?
  costCodeId         Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  payrollRun        PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee          Employee        @relation(fields: [employeeId], references: [id])
  payment           PayrollPayment?
  project           Project?        @relation(fields: [projectId], references: [id])
  projectCostCenter CostCenter?     @relation(fields: [costCenterId], references: [id])
  costCode          CostCode?       @relation(fields: [costCodeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@index([projectId, costCodeId])
  @@index([tenantId, companyId])
}

model PayrollPayment {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @default(1)
  companyId      Int      @default(1)
  payrollLineId  Int      @unique
  paymentNumber  String   @unique
  paymentDate    DateTime @default(now())
  amount         Decimal
  bankAccountId  Int
  journalEntryId Int?     @unique
  notes          String?
  createdAt      DateTime @default(now())

  payrollLine  PayrollLine   @relation(fields: [payrollLineId], references: [id])
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([tenantId, companyId])
}

model ExternalWorkerCost {
  id               Int      @id @default(autoincrement())
  tenantId         Int      @default(1)
  companyId        Int      @default(1)
  costNumber       String   @unique
  externalWorkerId Int
  costDate         DateTime @default(now())
  periodLabel      String?
  amount           Decimal
  costCenter       String
  expenseId        Int?     @unique
  status           String   @default("POSTED")
  notes            String?
  createdAt        DateTime @default(now())

  worker  ExternalWorker @relation(fields: [externalWorkerId], references: [id])
  expense Expense?       @relation(fields: [expenseId], references: [id])

  @@index([costDate])
  @@index([tenantId, companyId])
}

model ExternalTrade {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1)
  companyId       Int      @default(1)
  tradeNumber     String   @unique
  tradeDate       DateTime @default(now())
  tradeType       String
  itemId          Int
  entityName      String
  quantity        Decimal
  unitPrice       Decimal
  totalAmount     Decimal
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item        Item                 @relation(fields: [itemId], references: [id])
  linkedCosts ExternalLinkedCost[]

  @@index([tradeDate])
  @@index([itemId, tradeType])
  @@index([tenantId, companyId])
}

model ExternalLinkedCost {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1)
  companyId       Int      @default(1)
  costNumber      String   @unique
  costDate        DateTime @default(now())
  externalTradeId Int?
  itemId          Int
  costType        String
  entityName      String?
  description     String?
  amount          Decimal
  paymentMethod   String?
  notes           String?
  createdAt       DateTime @default(now())

  externalTrade ExternalTrade? @relation(fields: [externalTradeId], references: [id])
  item          Item           @relation(fields: [itemId], references: [id])

  @@index([costDate])
  @@index([itemId])
  @@index([tenantId, companyId])
}

model ExternalExpense {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1)
  companyId       Int      @default(1)
  expenseNumber   String   @unique
  expenseDate     DateTime @default(now())
  entityName      String?
  description     String
  category        String
  amount          Decimal
  paymentMethod   String?
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expenseDate])
  @@index([category])
  @@index([tenantId, companyId])
}

// ======================================================
// DRIVER DOCUMENTS
// وثائق السائق
// ======================================================

model DriverDocument {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)
  driverId  Int

  documentType   String
  documentNumber String?

  issueDate  DateTime?
  expiryDate DateTime?

  attachmentUrl String?
  notes         String?

  createdAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([expiryDate])
  @@index([tenantId, companyId])
}

// ======================================================
// TRANSPORT TRIPS
// الرحلات
//
// يتم إنشاء الرحلة تلقائياً من السند
// عندما تكون وسيلة النقل = سيارات الشركة
// ======================================================

model TransportTrip {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  tripNumber String   @unique
  tripDate   DateTime @default(now())

  noteId  Int? @unique
  partyId Int?
  itemId  Int?

  truckId  Int?
  driverId Int?

  quantity Decimal  @default(0)
  weight   Decimal?

  source         String?
  loadingPoint   String?
  unloadingPoint String?

  estimatedKm Decimal?
  actualKm    Decimal?

  // ----------------------------
  // Transport Revenue
  // إيراد النقل
  // ----------------------------

  transportRevenue     Decimal  @default(0)
  transportPricePerTon Decimal?

  // ----------------------------
  // Fuel
  // الديزل
  // ----------------------------

  fuelLiters        Decimal @default(0)
  fuelPricePerLiter Decimal @default(0)
  fuelCost          Decimal @default(0)

  // ----------------------------
  // Driver trip wage
  // أجرة السائق للرحلة
  // لا يوجد Bonus
  // ----------------------------

  driverTripFee       Decimal @default(0)
  driverPaidAmount    Decimal @default(0)
  driverPaymentStatus String  @default("DUE")

  // ----------------------------
  // Other trip costs
  // ----------------------------

  maintenanceCost    Decimal @default(0)
  administrativeCost Decimal @default(0)
  roadPermitCost     Decimal @default(0)
  otherCost          Decimal @default(0)

  // ----------------------------
  // Calculated financial values
  // ----------------------------

  totalCost Decimal @default(0)
  netProfit Decimal @default(0)

  status String @default("OPEN")

  notes        String?
  projectId    Int?
  costCenterId Int?
  costCodeId   Int?

