model FiscalYear {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  name                  String
  startDate             DateTime
  endDate               DateTime
  status                String    @default("OPEN")
  closingJournalEntryId Int?      @unique
  closedAt              DateTime?
  closedBy              String?
  reopenedAt            DateTime?
  createdAt             DateTime  @default(now())

  company        Company         @relation(fields: [companyId], references: [id])
  periods        FiscalPeriod[]
  closingJournal JournalEntry?   @relation("FiscalYearClosingJournal", fields: [closingJournalEntryId], references: [id])
  budgets        Budget[]
  fxRevaluations FxRevaluation[]

  @@unique([companyId, startDate, endDate])
  @@index([companyId, status])
}

model FiscalPeriod {
  id           Int       @id @default(autoincrement())
  fiscalYearId Int
  periodNumber Int
  name         String
  startDate    DateTime
  endDate      DateTime
  status       String    @default("OPEN")
  closedAt     DateTime?
  closedBy     String?
  reopenedAt   DateTime?
  createdAt    DateTime  @default(now())

  fiscalYear     FiscalYear      @relation(fields: [fiscalYearId], references: [id])
  budgetLines    BudgetLine[]
  fxRevaluations FxRevaluation[]

  @@unique([fiscalYearId, periodNumber])
  @@index([startDate, endDate])
}

model Currency {
  code          String   @id
  nameAr        String
  nameEn        String
  symbol        String?
  decimalPlaces Int      @default(2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  companies          Company[]
  baseExchangeRates  ExchangeRate[] @relation("BaseCurrency")
  quoteExchangeRates ExchangeRate[] @relation("QuoteCurrency")
}

model ExchangeRate {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @default(1)
  companyId         Int
  baseCurrencyCode  String
  quoteCurrencyCode String
  rateDate          DateTime
  rate              Decimal
  source            String?
  createdBy         String?
  createdAt         DateTime @default(now())

  company       Company  @relation(fields: [companyId], references: [id])
  baseCurrency  Currency @relation("BaseCurrency", fields: [baseCurrencyCode], references: [code])
  quoteCurrency Currency @relation("QuoteCurrency", fields: [quoteCurrencyCode], references: [code])

  @@unique([companyId, baseCurrencyCode, quoteCurrencyCode, rateDate])
  @@index([companyId, rateDate])
  @@index([tenantId, companyId])
}

model FxRevaluation {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  revaluationNumber      String    @unique
  revaluationDate        DateTime
  fiscalYearId           Int
  fiscalPeriodId         Int
  currencyCode           String
  exchangeRate           Decimal
  status                 String    @default("DRAFT")
  totalGain              Decimal   @default(0)
  totalLoss              Decimal   @default(0)
  journalEntryId         Int?      @unique
  reversalJournalEntryId Int?      @unique
  reversalDate           DateTime?
  postedAt               DateTime?
  postedBy               String?
  reversedAt             DateTime?
  reversedBy             String?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company         Company             @relation(fields: [companyId], references: [id])
  fiscalYear      FiscalYear          @relation(fields: [fiscalYearId], references: [id])
  fiscalPeriod    FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id])
  journalEntry    JournalEntry?       @relation("FxRevaluationJournal", fields: [journalEntryId], references: [id])
  reversalJournal JournalEntry?       @relation("FxRevaluationReversalJournal", fields: [reversalJournalEntryId], references: [id])
  lines           FxRevaluationLine[]

  @@unique([tenantId, companyId, fiscalPeriodId, currencyCode])
  @@index([tenantId, companyId, revaluationDate])
}

model FxRevaluationLine {
  id                       Int      @id @default(autoincrement())
  tenantId                 Int      @default(1)
  companyId                Int      @default(1)
  revaluationId            Int
  accountId                Int
  partyId                  Int?
  sourceType               String
  sourceId                 Int
  sourceNumber             String
  transactionBalance       Decimal
  carryingFunctionalAmount Decimal
  revaluedFunctionalAmount Decimal
  difference               Decimal
  createdAt                DateTime @default(now())

  revaluation FxRevaluation @relation(fields: [revaluationId], references: [id], onDelete: Cascade)

  @@unique([revaluationId, sourceType, sourceId, accountId])
  @@index([tenantId, companyId])
  @@index([revaluationId])
}

model Budget {
  id           Int       @id @default(autoincrement())
