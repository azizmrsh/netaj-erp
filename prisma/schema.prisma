  code      String   @unique
  nameAr    String
  nameEn    String?
  category  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company              Company                  @relation(fields: [companyId], references: [id])
  budgets              ProjectCostBudget[]
  boqItems             ProjectBoqItem[]
  changeOrderLines     ProjectChangeOrderLine[]
  purchases            Purchase[]
  sales                Sale[]
  expenses             Expense[]
  stockMovements       StockMovement[]
  transportTrips       TransportTrip[]
  payrollLines         PayrollLine[]
  documents            BusinessDocument[]
  journalLines         JournalEntryLine[]
  subcontractContracts SubcontractorContract[]
  notes                DeliveryReceiptNote[]

  @@index([tenantId, companyId])
}

model Project {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @default(1)
  companyId        Int       @default(1)
  projectNumber    String    @unique
  name             String
  partyId          Int
  billingItemId    Int?
  costCenterId     Int
  projectManager   String?
  startDate        DateTime
  endDate          DateTime?
  status           String    @default("PLANNED")
  contractValue    Decimal   @default(0)
  advanceAmount    Decimal   @default(0)
  retentionPercent Decimal   @default(0)
  progressPercent  Decimal   @default(0)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company        Company                 @relation(fields: [companyId], references: [id])
  customer       Party                   @relation(fields: [partyId], references: [id])
  billingItem    Item?                   @relation("ProjectBillingItem", fields: [billingItemId], references: [id])
  costCenter     CostCenter              @relation(fields: [costCenterId], references: [id])
  contracts      ProjectContract[]
  boqItems       ProjectBoqItem[]
  budgets        ProjectCostBudget[]
  changeOrders   ProjectChangeOrder[]
  progress       ProjectProgress[]
  certificates   ProgressCertificate[]
  subcontractors SubcontractorContract[]
  sales          Sale[]
  purchases      Purchase[]
  expenses       Expense[]
  stockMovements StockMovement[]
  transportTrips TransportTrip[]
  payrollLines   PayrollLine[]
  documents      BusinessDocument[]
  deliveryNotes  DeliveryReceiptNote[]

  @@index([tenantId, companyId, status])
  @@index([partyId])
}

model ProjectContract {
