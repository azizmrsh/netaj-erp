generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ======================================================
// NETAJ ERP
// Core Database Schema - Phase 1
// ======================================================

// ======================================================
// ENTITIES
// العميل / المورد / الاثنين معاً
// ======================================================

model Party {
  sales     Sale[]
  purchases Purchase[]
  id        Int        @id @default(autoincrement())
  tenantId  Int        @default(1)
  companyId Int        @default(1)

  nameAr String
  nameEn String?

  unifiedNumber String? @unique
  vatNumber     String?

  telephone String?
  email     String?

  isCustomer Boolean @default(false)
  isSupplier Boolean @default(false)

  isActive Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address PartyAddress?

  stockAccounts       PartyStockAccount[]
  stockMovements      StockMovement[]
  transportTrips      TransportTrip[]
  businessDocuments   BusinessDocument[]
  financialVouchers   FinancialVoucher[]
  factoryTransactions FactoryTransaction[]
  factoryFeeRates     FactoryFeeRate[]

  notesDocuments DeliveryReceiptNote[]

  @@index([tenantId, companyId])
}

// ======================================================
// NATIONAL ADDRESS
// العنوان الوطني
// ======================================================

model PartyAddress {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  partyId Int @unique

  buildingNumber  String?
  street          String?
  secondaryNumber String?
  district        String?
  city            String?
  postalCode      String?
  region          String?
  shortAddress    String?
  mapLink         String?

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId])
}

// ======================================================
// ITEM CATEGORIES
// تصنيفات المواد
// ======================================================

model ItemCategory {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  nameAr String
  nameEn String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@index([tenantId, companyId])
}

// ======================================================
// UNITS
// الوحدات
// طن / كجم / لتر / قطعة / برميل
// ======================================================

model Unit {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  code String @unique

  nameAr String
  nameEn String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@index([tenantId, companyId])
}

// ======================================================
// ITEMS / MATERIALS
// المواد والمنتجات
// ======================================================

model Item {
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  id            Int            @id @default(autoincrement())
  tenantId      Int            @default(1)
  companyId     Int            @default(1)

  code String @unique

  nameAr String
  nameEn String?

  categoryId Int?
  unitId     Int

  specification   String?
  manufacturer    String?
  countryOfOrigin String?
  batchNumber     String?

  costPrice Decimal @default(0)
  salePrice Decimal @default(0)

  vatRate Decimal @default(15)

  minimumStock Decimal @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ItemCategory? @relation(fields: [categoryId], references: [id])

  unit Unit @relation(fields: [unitId], references: [id])

  companyStock CompanyStock?

  partyStocks PartyStockAccount[]

  stockMovements        StockMovement[]
  transportTrips        TransportTrip[]
  businessDocumentLines BusinessDocumentLine[]

  noteItems            DeliveryReceiptNoteItem[]
  factoryTransactions  FactoryTransaction[]
  factoryFeeRates      FactoryFeeRate[]
  factoryFuelMovements FactoryFuelMovement[]
  externalTrades       ExternalTrade[]
  externalLinkedCosts  ExternalLinkedCost[]

  @@index([tenantId, companyId])
}

// ======================================================
// COMPANY MAIN STOCK
// مخزون الشركة الرئيسي
// ======================================================

model CompanyStock {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  itemId Int @unique

  quantity Decimal @default(0)

  averageCost Decimal @default(0)

  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId])
}

// ======================================================
// CUSTOMER / PARTY STOCK
// مخزون العميل المستقل
//
// مهم:
// الرصيد يمكن أن يصبح سالباً.
// النظام سيحذر المستخدم ولكنه لا يمنع العملية.
// ======================================================

model PartyStockAccount {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  partyId Int
  itemId  Int

  quantity     Decimal @default(0)
  averageValue Decimal @default(0)

  updatedAt DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([partyId, itemId])
  @@index([tenantId, companyId])
}

// ======================================================
// STOCK MOVEMENTS
// حركة المخزون
//
// ownershipType:
//
// COMPANY
// CUSTOMER
//
// movementType:
//
// OPENING
// RECEIPT
// DELIVERY
// PURCHASE
// SALE
// TRANSFER_IN
// TRANSFER_OUT
// PROCESSING_IN
// PROCESSING_OUT
// ADJUSTMENT
// ======================================================

model StockMovement {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  movementNumber String @unique

  movementDate DateTime @default(now())

  itemId  Int
  partyId Int?

  ownershipType String
  movementType  String

  quantityIn  Decimal @default(0)
  quantityOut Decimal @default(0)

  unitCost   Decimal @default(0)
  totalValue Decimal @default(0)

  balanceAfter Decimal?

  referenceType   String?
  referenceId     Int?
  referenceNumber String?

  notes String?

  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])

  party Party? @relation(fields: [partyId], references: [id])

  factoryFuelMovement FactoryFuelMovement?

  @@index([movementDate])
  @@index([itemId])
  @@index([partyId])
  @@index([tenantId, companyId])
}

// ======================================================
// RECEIPT / DELIVERY NOTES
//
// سند استلام
// سند تسليم
//
// لا توجد أسعار في السند.
// ======================================================

model DeliveryReceiptNote {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  noteNumber String @unique

  noteType String
  noteDate DateTime @default(now())

  partyId          Int
  sourceDocumentId Int?

  // COMPANY or PARTY. This determines which ownership ledger is affected
  // when the document is posted.
  stockOwnership String @default("PARTY")

  invoiceNumber   String?
  orderNumber     String?
  referenceNumber String?

  // ------------------------------------------
  // Transport Method
  //
  // COMPANY
  // CUSTOMER
  // EXTERNAL
  // ------------------------------------------

  transportMethod String?

  truckId  Int?
  driverId Int?

  carrierName String?

  vehiclePlate String?

  driverName     String?
  driverIdNumber String?
  driverPhone    String?

  source String?

  loadingPoint   String?
  unloadingPoint String?

  status String @default("DRAFT")

  stockPostedAt DateTime?
  cancelledAt   DateTime?

  notes String?

  // ------------------------------------------
  // Signatures
  // ------------------------------------------

  recipientName       String?
  recipientSignature  String?
  recipientSignedAt   DateTime?
  purchasingName      String?
  purchasingSignature String?
  purchasingSignedAt  DateTime?
  warehouseName       String?
  warehouseSignature  String?
  warehouseSignedAt   DateTime?
  accountantName      String?
  accountantSignature String?
  accountantSignedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party          Party             @relation(fields: [partyId], references: [id])
  sourceDocument BusinessDocument? @relation(fields: [sourceDocumentId], references: [id])

  truck  Truck?  @relation(fields: [truckId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  items            DeliveryReceiptNoteItem[]
  trip             TransportTrip?
  salesInvoices    Sale[]
  purchaseInvoices Purchase[]

  @@index([noteDate])
  @@index([partyId])
  @@index([sourceDocumentId])
  @@index([tenantId, companyId])
}

// ======================================================
// RECEIPT / DELIVERY NOTE ITEMS
//
// بدون أسعار
// ======================================================

model DeliveryReceiptNoteItem {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  noteId Int
  itemId Int

  sequence Int

  description   String?
  materialGrade String?
  orderNumber   String?

  quantity Decimal
  weight   Decimal?

  note DeliveryReceiptNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  item Item @relation(fields: [itemId], references: [id])

  @@index([noteId])
  @@index([itemId])
  @@index([tenantId, companyId])
}

// ======================================================
// TRANSPORT MODULE
// نظام النقل
// ======================================================

model Truck {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @default(1)
  companyId   Int      @default(1)
  plateNumber String   @unique
  truckType   String?
  model       String?
  modelYear   Int?
  trailerType String?
  capacity    Decimal?
  status      String   @default("ACTIVE")

  fuelType         String?
  fuelConsumption  Decimal? // liters per 100 km
  fuelPrice        Decimal?
  maintenancePerKm Decimal?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     TruckDocument[]
  trips         TransportTrip[]
  deliveryNotes DeliveryReceiptNote[]

  @@index([tenantId, companyId])
}

// ======================================================
// TRUCK DOCUMENTS
// وثائق الشاحنات
// ======================================================

model TruckDocument {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)
  truckId   Int

  documentType   String
  documentNumber String?

  issueDate  DateTime?
  expiryDate DateTime?

  attachmentUrl String?
  notes         String?

  createdAt DateTime @default(now())

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@index([truckId])
  @@index([expiryDate])
  @@index([tenantId, companyId])
}

// ======================================================
// DRIVERS
// السائقون
// ======================================================

model Driver {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  name        String
  idNumber    String? @unique
  phone       String?
  nationality String?

  licenseNumber String?
  licenseExpiry DateTime?

  passportNumber String?
  passportExpiry DateTime?

  driverCardNumber String?
  driverCardExpiry DateTime?

  status     String  @default("ACTIVE")
  notes      String?
  employeeId Int?    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     DriverDocument[]
  trips         TransportTrip[]
  deliveryNotes DeliveryReceiptNote[]
  employee      Employee?             @relation(fields: [employeeId], references: [id])

  @@index([tenantId, companyId])
}

model Employee {
  id                 Int       @id @default(autoincrement())
  tenantId           Int       @default(1)
  companyId          Int       @default(1)
  employeeNumber     String    @unique
  nameAr             String
  nameEn             String?
  idNumber           String?   @unique
  nationality        String?
  dateOfBirth        DateTime?
  phone              String?
  email              String?
  address            String?
  department         String?
  jobTitle           String?
  hireDate           DateTime?
  managerId          Int?
  contractType       String?
  basicSalary        Decimal   @default(0)
  housingAllowance   Decimal   @default(0)
  transportAllowance Decimal   @default(0)
  otherAllowance     Decimal   @default(0)
  bankName           String?
  iban               String?
  costCenter         String?
  status             String    @default("ACTIVE")
  idExpiry           DateTime?
  contractExpiry     DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  manager       Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates  Employee[]         @relation("EmployeeManager")
  driver        Driver?
  attendance    AttendanceRecord[]
  payrollLines  PayrollLine[]
  advances      EmployeeAdvance[]
  leaveRequests LeaveRequest[]

  @@index([department])
  @@index([status])
  @@index([tenantId, companyId])
}

model ExternalWorker {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @default(1)
  companyId        Int       @default(1)
  workerNumber     String    @unique
  name             String
  affiliatedEntity String?
  role             String?
  idNumber         String?
  phone            String?
  startDate        DateTime?
  endDate          DateTime?
  wage             Decimal   @default(0)
  paymentMethod    String?
  costCenter       String?
  status           String    @default("ACTIVE")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  costs ExternalWorkerCost[]

  @@index([tenantId, companyId])
}

model AttendanceRecord {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @default(1)
  companyId      Int      @default(1)
  employeeId     Int
  attendanceDate DateTime
  status         String
  workHours      Decimal  @default(0)
  overtimeHours  Decimal  @default(0)
  fridayHours    Decimal  @default(0)
  checkIn        String?
  checkOut       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@index([tenantId, companyId])
}

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @default(1)
  companyId  Int      @default(1)
  employeeId Int
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  status     String   @default("SUBMITTED")
  reason     String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([startDate, endDate])
  @@index([tenantId, companyId])
}

model EmployeeAdvance {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1)
  companyId       Int      @default(1)
  advanceNumber   String   @unique
  employeeId      Int
  advanceDate     DateTime @default(now())
  amount          Decimal
  recoveredAmount Decimal  @default(0)
  remainingAmount Decimal
  bankAccountId   Int
  journalEntryId  Int?     @unique
  status          String   @default("OPEN")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id])
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([employeeId])
  @@index([tenantId, companyId])
}

model PayrollRun {
  id              Int       @id @default(autoincrement())
  tenantId        Int       @default(1)
  companyId       Int       @default(1)
  payrollNumber   String    @unique
  year            Int
  month           Int
  status          String    @default("DRAFT")
  totalGross      Decimal   @default(0)
  totalDeductions Decimal   @default(0)
  totalNet        Decimal   @default(0)
  journalEntryId  Int?      @unique
  postedAt        DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines        PayrollLine[]
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@unique([year, month])
  @@index([tenantId, companyId])
}

model PayrollLine {
  id                 Int      @id @default(autoincrement())
  tenantId           Int      @default(1)
  companyId          Int      @default(1)
  payrollRunId       Int
  employeeId         Int
  basicSalary        Decimal  @default(0)
  housingAllowance   Decimal  @default(0)
  transportAllowance Decimal  @default(0)
  otherAllowances    Decimal  @default(0)
  normalWage         Decimal  @default(0)
  overtimeHours      Decimal  @default(0)
  overtimeValue      Decimal  @default(0)
  fridayHours        Decimal  @default(0)
  fridayValue        Decimal  @default(0)
  absenceDeduction   Decimal  @default(0)
  penalties          Decimal  @default(0)
  advances           Decimal  @default(0)
  otherDeductions    Decimal  @default(0)
  grossSalary        Decimal  @default(0)
  totalDeductions    Decimal  @default(0)
  netSalary          Decimal  @default(0)
  paymentStatus      String   @default("DUE")
  paidAmount         Decimal  @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  payrollRun PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee        @relation(fields: [employeeId], references: [id])
  payment    PayrollPayment?

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@index([tenantId, companyId])
}

model PayrollPayment {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @default(1)
  companyId      Int      @default(1)
  payrollLineId  Int      @unique
  paymentNumber  String   @unique
  paymentDate    DateTime @default(now())
  amount         Decimal
  bankAccountId  Int
  journalEntryId Int?     @unique
  notes          String?
  createdAt      DateTime @default(now())

  payrollLine  PayrollLine   @relation(fields: [payrollLineId], references: [id])
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([tenantId, companyId])
}

model ExternalWorkerCost {
  id               Int      @id @default(autoincrement())
  tenantId         Int      @default(1)
  companyId        Int      @default(1)
  costNumber       String   @unique
  externalWorkerId Int
  costDate         DateTime @default(now())
  periodLabel      String?
  amount           Decimal
  costCenter       String
  expenseId        Int?     @unique
  status           String   @default("POSTED")
  notes            String?
  createdAt        DateTime @default(now())

  worker  ExternalWorker @relation(fields: [externalWorkerId], references: [id])
  expense Expense?       @relation(fields: [expenseId], references: [id])

  @@index([costDate])
  @@index([tenantId, companyId])
}

model ExternalTrade {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1)
  companyId       Int      @default(1)
  tradeNumber     String   @unique
  tradeDate       DateTime @default(now())
  tradeType       String
  itemId          Int
  entityName      String
  quantity        Decimal
  unitPrice       Decimal
  totalAmount     Decimal
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item        Item                 @relation(fields: [itemId], references: [id])
  linkedCosts ExternalLinkedCost[]

  @@index([tradeDate])
  @@index([itemId, tradeType])
  @@index([tenantId, companyId])
}

model ExternalLinkedCost {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1)
  companyId       Int      @default(1)
  costNumber      String   @unique
  costDate        DateTime @default(now())
  externalTradeId Int?
  itemId          Int
  costType        String
  entityName      String?
  description     String?
  amount          Decimal
  paymentMethod   String?
  notes           String?
  createdAt       DateTime @default(now())

  externalTrade ExternalTrade? @relation(fields: [externalTradeId], references: [id])
  item          Item           @relation(fields: [itemId], references: [id])

  @@index([costDate])
  @@index([itemId])
  @@index([tenantId, companyId])
}

model ExternalExpense {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1)
  companyId       Int      @default(1)
  expenseNumber   String   @unique
  expenseDate     DateTime @default(now())
  entityName      String?
  description     String
  category        String
  amount          Decimal
  paymentMethod   String?
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expenseDate])
  @@index([category])
  @@index([tenantId, companyId])
}

// ======================================================
// DRIVER DOCUMENTS
// وثائق السائق
// ======================================================

model DriverDocument {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)
  driverId  Int

  documentType   String
  documentNumber String?

  issueDate  DateTime?
  expiryDate DateTime?

  attachmentUrl String?
  notes         String?

  createdAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([expiryDate])
  @@index([tenantId, companyId])
}

// ======================================================
// TRANSPORT TRIPS
// الرحلات
//
// يتم إنشاء الرحلة تلقائياً من السند
// عندما تكون وسيلة النقل = سيارات الشركة
// ======================================================

model TransportTrip {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  tripNumber String   @unique
  tripDate   DateTime @default(now())

  noteId  Int? @unique
  partyId Int?
  itemId  Int?

  truckId  Int?
  driverId Int?

  quantity Decimal  @default(0)
  weight   Decimal?

  source         String?
  loadingPoint   String?
  unloadingPoint String?

  estimatedKm Decimal?
  actualKm    Decimal?

  // ----------------------------
  // Transport Revenue
  // إيراد النقل
  // ----------------------------

  transportRevenue     Decimal  @default(0)
  transportPricePerTon Decimal?

  // ----------------------------
  // Fuel
  // الديزل
  // ----------------------------

  fuelLiters        Decimal @default(0)
  fuelPricePerLiter Decimal @default(0)
  fuelCost          Decimal @default(0)

  // ----------------------------
  // Driver trip wage
  // أجرة السائق للرحلة
  // لا يوجد Bonus
  // ----------------------------

  driverTripFee       Decimal @default(0)
  driverPaidAmount    Decimal @default(0)
  driverPaymentStatus String  @default("DUE")

  // ----------------------------
  // Other trip costs
  // ----------------------------

  maintenanceCost    Decimal @default(0)
  administrativeCost Decimal @default(0)
  roadPermitCost     Decimal @default(0)
  otherCost          Decimal @default(0)

  // ----------------------------
  // Calculated financial values
  // ----------------------------

  totalCost Decimal @default(0)
  netProfit Decimal @default(0)

  status String @default("OPEN")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  truck  Truck?               @relation(fields: [truckId], references: [id])
  driver Driver?              @relation(fields: [driverId], references: [id])
  note   DeliveryReceiptNote? @relation(fields: [noteId], references: [id])
  party  Party?               @relation(fields: [partyId], references: [id])
  item   Item?                @relation(fields: [itemId], references: [id])

  expenses TransportTripExpense[]

  @@index([tripDate])
  @@index([partyId])
  @@index([itemId])
  @@index([truckId])
  @@index([driverId])
  @@index([tenantId, companyId])
}

// ======================================================
// ADDITIONAL TRIP EXPENSES
// مصاريف إضافية للرحلة
// ======================================================

model TransportTripExpense {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  tripId Int

  expenseDate DateTime @default(now())
  expenseType String
  description String?

  amount Decimal @default(0)

  attachmentUrl String?
  notes         String?

  createdAt DateTime @default(now())

  trip TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tenantId, companyId])
}

// ============================================================
// SALES
// المبيعات
// ============================================================

model Sale {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  invoiceNumber String   @unique
  invoiceDate   DateTime @default(now())

  partyId              Int
  sourceOrderId        Int?
  deliveryNoteId       Int? @unique
  factoryTransactionId Int? @unique

  referenceNumber     String?
  purchaseOrderNumber String?
  paymentMethod       String?
  dueDate             DateTime?
  currency            String    @default("SAR")

  subtotal    Decimal @default(0)
  discount    Decimal @default(0)
  vatAmount   Decimal @default(0)
  totalAmount Decimal @default(0)

  status String  @default("DRAFT")
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party              Party                @relation(fields: [partyId], references: [id])
  items              SaleItem[]
  sourceOrder        BusinessDocument?    @relation("SalesInvoiceOrder", fields: [sourceOrderId], references: [id])
  deliveryNote       DeliveryReceiptNote? @relation(fields: [deliveryNoteId], references: [id])
  allocations        VoucherAllocation[]
  factoryTransaction FactoryTransaction?  @relation(fields: [factoryTransactionId], references: [id])

  @@index([invoiceDate])
  @@index([partyId])
  @@index([sourceOrderId])
  @@index([tenantId, companyId])
}

model SaleItem {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  saleId        Int
  itemId        Int
  description   String?
  materialGrade String?

  quantity    Decimal @default(0)
  unitPrice   Decimal @default(0)
  discount    Decimal @default(0)
  vatRate     Decimal @default(15)
  vatAmount   Decimal @default(0)
  totalAmount Decimal @default(0)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

  @@index([saleId])
  @@index([itemId])
  @@index([tenantId, companyId])
}

// ============================================================
// PURCHASES
// المشتريات
// ============================================================

model Purchase {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  purchaseNumber String   @unique
  purchaseDate   DateTime @default(now())

  partyId       Int
  sourceOrderId Int?
  receiptNoteId Int?      @unique
  dueDate       DateTime?
  paymentMethod String?
  currency      String    @default("SAR")

  supplierInvoiceNumber String?
  referenceNumber       String?

  subtotal    Decimal @default(0)
  discount    Decimal @default(0)
  vatAmount   Decimal @default(0)
  totalAmount Decimal @default(0)

  status String  @default("DRAFT")
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party       Party                @relation(fields: [partyId], references: [id])
  items       PurchaseItem[]
  sourceOrder BusinessDocument?    @relation("SupplierInvoiceOrder", fields: [sourceOrderId], references: [id])
  receiptNote DeliveryReceiptNote? @relation(fields: [receiptNoteId], references: [id])
  allocations VoucherAllocation[]

  @@index([purchaseDate])
  @@index([partyId])
  @@index([sourceOrderId])
  @@index([tenantId, companyId])
}

model PurchaseItem {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  purchaseId     Int
  itemId         Int
  description    String?
  materialGrade  String?
  specifications String?

  quantity    Decimal @default(0)
  unitPrice   Decimal @default(0)
  discount    Decimal @default(0)
  vatRate     Decimal @default(15)
  vatAmount   Decimal @default(0)
  totalAmount Decimal @default(0)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@index([purchaseId])
  @@index([itemId])
  @@index([tenantId, companyId])
}

// ============================================================
// FACTORY
// المصنع - تكلفة التصنيع مستقلة عن ملكية خام العميل
// ============================================================

model FactoryTransaction {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  transactionNumber String   @unique
  transactionDate   DateTime @default(now())

  partyId Int?
  itemId  Int?

  transactionType String

  quantity               Decimal @default(0)
  manufacturingFeePerTon Decimal @default(0)
  manufacturingFeeTotal  Decimal @default(0)
  vatRate                Decimal @default(15)
  vatAmount              Decimal @default(0)
  totalAmount            Decimal @default(0)

  description String?
  notes       String?

  status          String    @default("POSTED")
  referenceType   String?
  referenceId     Int?
  referenceNumber String?
  journalEntryId  Int?      @unique
  postedAt        DateTime?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party        Party?        @relation(fields: [partyId], references: [id])
  item         Item?         @relation(fields: [itemId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  sale         Sale?

  @@index([transactionDate])
  @@index([partyId])
  @@index([itemId])
  @@index([tenantId, companyId])
}

model FactoryFeeRate {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @default(1)
  companyId Int      @default(1)
  partyId   Int
  itemId    Int
  feePerTon Decimal
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id])
  item  Item  @relation(fields: [itemId], references: [id])

  @@unique([partyId, itemId])
  @@index([tenantId, companyId])
}

model FactoryFuelMovement {
  id               Int      @id @default(autoincrement())
  tenantId         Int      @default(1)
  companyId        Int      @default(1)
  movementNumber   String   @unique
  movementDate     DateTime @default(now())
  itemId           Int
  movementType     String
  quantityIn       Decimal  @default(0)
  quantityOut      Decimal  @default(0)
  unitCost         Decimal  @default(0)
  totalValue       Decimal  @default(0)
  balanceAfter     Decimal
  balanceValue     Decimal
  productionItemId Int?
  stockMovementId  Int      @unique
  journalEntryId   Int?     @unique
  referenceType    String?
  referenceId      Int?
  referenceNumber  String?
  notes            String?
  createdAt        DateTime @default(now())

  item          Item          @relation(fields: [itemId], references: [id])
  stockMovement StockMovement @relation(fields: [stockMovementId], references: [id])
  journalEntry  JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([movementDate])
  @@index([itemId])
  @@index([productionItemId])
  @@index([tenantId, companyId])
}

model FactoryMaintenance {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @default(1)
  companyId         Int      @default(1)
  maintenanceNumber String   @unique
  maintenanceDate   DateTime @default(now())
  equipment         String
  maintenanceType   String
  spareParts        String?
  laborDescription  String?
  vendor            String?
  description       String?
  amount            Decimal  @default(0)
  expenseId         Int?     @unique
  status            String   @default("POSTED")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  expense Expense? @relation(fields: [expenseId], references: [id])

  @@index([maintenanceDate])
  @@index([tenantId, companyId])
}

model FactoryExpense {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  expenseDate DateTime @default(now())
  expenseType String
  description String?

  amount Decimal @default(0)

  supplierName    String?
  referenceNumber String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseDate])
  @@index([expenseType])
  @@index([tenantId, companyId])
}

// ============================================================
// ACCOUNTING
// المحاسبة
// ============================================================

model JournalEntry {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  entryNumber String   @unique
  entryDate   DateTime @default(now())

  description     String?
  referenceType   String?
  referenceId     Int?
  referenceNumber String?

  status      String    @default("DRAFT")
  totalDebit  Decimal   @default(0)
  totalCredit Decimal   @default(0)
  postedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines               JournalEntryLine[]
  financialVoucher    FinancialVoucher?
  expense             Expense?
  revenue             Revenue?
  bankTransfer        BankTransfer?
  factoryTransaction  FactoryTransaction?
  factoryFuelMovement FactoryFuelMovement?
  employeeAdvance     EmployeeAdvance?
  payrollRun          PayrollRun?
  payrollPayment      PayrollPayment?

  @@unique([referenceType, referenceId])
  @@index([entryDate])
  @@index([tenantId, companyId])
}

model JournalEntryLine {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  journalEntryId Int

  accountCode String
  accountName String
  accountId   Int?

  debit  Decimal @default(0)
  credit Decimal @default(0)

  partyId     Int?
  costCenter  String?
  description String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([partyId])
  @@index([accountId])
  @@index([tenantId, companyId])
}

// ============================================================
// OPERATIONAL DOCUMENT WORKFLOW
// QT / PI / SO / PR / PO
// ============================================================

model BusinessDocument {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @default(1)
  companyId        Int       @default(1)
  documentNumber   String    @unique
  documentType     String
  direction        String
  documentDate     DateTime  @default(now())
  expiryDate       DateTime?
  neededDate       DateTime?
  partyId          Int
  sourceDocumentId Int?
  referenceNumber  String?
  salesperson      String?
  requester        String?
  department       String?
  costCenter       String?
  priority         String?
  currency         String    @default("SAR")
  bankDetails      String?
  paymentTerms     String?
  deliveryTime     String?
  deliveryPlace    String?
  deliveryTerms    String?
  subtotal         Decimal   @default(0)
  discount         Decimal   @default(0)
  vatAmount        Decimal   @default(0)
  totalAmount      Decimal   @default(0)
  status           String    @default("DRAFT")
  approvedAt       DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  party              Party                  @relation(fields: [partyId], references: [id])
  sourceDocument     BusinessDocument?      @relation("DocumentConversion", fields: [sourceDocumentId], references: [id])
  convertedDocuments BusinessDocument[]     @relation("DocumentConversion")
  lines              BusinessDocumentLine[]
  deliveryNotes      DeliveryReceiptNote[]
  salesInvoices      Sale[]                 @relation("SalesInvoiceOrder")
  supplierInvoices   Purchase[]             @relation("SupplierInvoiceOrder")

  @@unique([sourceDocumentId, documentType])
  @@index([documentType, documentDate])
  @@index([partyId])
  @@index([status])
  @@index([tenantId, companyId])
}

model BusinessDocumentLine {
  id             Int     @id @default(autoincrement())
  tenantId       Int     @default(1)
  companyId      Int     @default(1)
  documentId     Int
  sequence       Int
  lineType       String  @default("ITEM")
  itemId         Int?
  description    String?
  materialGrade  String?
  specifications String?
  quantity       Decimal @default(0)
  unitPrice      Decimal @default(0)
  discount       Decimal @default(0)
  vatRate        Decimal @default(15)
  vatAmount      Decimal @default(0)
  totalAmount    Decimal @default(0)

  document BusinessDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item     Item?            @relation(fields: [itemId], references: [id])

  @@index([documentId])
  @@index([itemId])
  @@index([tenantId, companyId])
}

model DocumentSequence {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @default(1)
  companyId    Int      @default(1)
  code         String
  year         Int
  currentValue Int      @default(0)
  padding      Int      @default(6)
  prefix       String
  updatedAt    DateTime @updatedAt

  @@unique([code, year])
  @@index([tenantId, companyId])
}

model Attachment {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @default(1)
  companyId    Int      @default(1)
  entityType   String
  entityId     Int
  originalName String
  storedName   String   @unique
  storagePath  String
  mimeType     String
  size         Int
  uploadedBy   String?
  uploadedAt   DateTime @default(now())
  notes        String?

  @@index([entityType, entityId])
  @@index([tenantId, companyId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @default(1)
  companyId  Int      @default(1)
  action     String
  entityType String
  entityId   Int?
  userId     String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tenantId, companyId])
}

model Account {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @default(1)
  companyId    Int      @default(1)
  code         String   @unique
  nameAr       String
  nameEn       String?
  accountType  String
  parentId     Int?
  isActive     Boolean  @default(true)
  allowPosting Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent            Account?            @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          Account[]           @relation("AccountHierarchy")
  journalLines      JournalEntryLine[]
  mappings          AccountingMapping[]
  bankAccounts      BankAccount[]
  expenseCategories ExpenseCategory[]
  revenueCategories RevenueCategory[]

  @@index([parentId])
  @@index([tenantId, companyId])
}

model AccountingMapping {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @default(1)
  companyId   Int      @default(1)
  key         String   @unique
  accountId   Int
  description String?
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([tenantId, companyId])
}

model AccountingPeriod {
  id        Int       @id @default(autoincrement())
  tenantId  Int       @default(1)
  companyId Int       @default(1)
  name      String
  startDate DateTime
  endDate   DateTime
  status    String    @default("OPEN")
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([startDate, endDate])
  @@index([tenantId, companyId])
}

model Expense {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  voucherNumber String   @unique
  expenseDate   DateTime @default(now())

  expenseType String
  description String?
  beneficiary String?

  amountBeforeVat Decimal @default(0)
  vatAmount       Decimal @default(0)
  totalAmount     Decimal @default(0)

  paymentMethod       String?
  cashBankAccount     String?
  costCenter          String?
  responsibleEmployee String?
  project             String?

  categoryId     Int?
  bankAccountId  Int?
  journalEntryId Int?      @unique
  status         String    @default("DRAFT")
  postedAt       DateTime?
  cancelledAt    DateTime?

  referenceNumber String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category           ExpenseCategory?    @relation(fields: [categoryId], references: [id])
  bankAccount        BankAccount?        @relation(fields: [bankAccountId], references: [id])
  journalEntry       JournalEntry?       @relation(fields: [journalEntryId], references: [id])
  factoryMaintenance FactoryMaintenance?
  externalWorkerCost ExternalWorkerCost?

  @@index([expenseDate])
  @@index([expenseType])
  @@index([tenantId, companyId])
}

model Revenue {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  voucherNumber String   @unique
  revenueDate   DateTime @default(now())

  revenueType String
  partyId     Int?

  description String?

  amountBeforeVat Decimal @default(0)
  vatAmount       Decimal @default(0)
  totalAmount     Decimal @default(0)

  collectionMethod String?
  cashBankAccount  String?
  activity         String?
  costCenter       String?

  categoryId     Int?
  bankAccountId  Int?
  journalEntryId Int?      @unique
  status         String    @default("DRAFT")
  postedAt       DateTime?
  cancelledAt    DateTime?

  referenceNumber String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     RevenueCategory? @relation(fields: [categoryId], references: [id])
  bankAccount  BankAccount?     @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry?    @relation(fields: [journalEntryId], references: [id])

  @@index([revenueDate])
  @@index([partyId])
  @@index([tenantId, companyId])
}

model CostCenter {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @default(1)
  companyId Int      @default(1)
  code      String   @unique
  nameAr    String
  nameEn    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([tenantId, companyId])
}

model ExpenseCategory {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @default(1)
  companyId Int      @default(1)
  code      String   @unique
  nameAr    String
  nameEn    String?
  accountId Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account  Account   @relation(fields: [accountId], references: [id])
  expenses Expense[]

  @@index([tenantId, companyId])
}

model RevenueCategory {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @default(1)
  companyId Int      @default(1)
  code      String   @unique
  nameAr    String
  nameEn    String?
  accountId Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account  Account   @relation(fields: [accountId], references: [id])
  revenues Revenue[]

  @@index([tenantId, companyId])
}

model BankAccount {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1)
  companyId       Int      @default(1)
  name            String
  bankName        String?
  accountNumber   String?
  iban            String?  @unique
  currency        String   @default("SAR")
  openingBalance  Decimal  @default(0)
  currentBalance  Decimal  @default(0)
  ledgerAccountId Int
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ledgerAccount     Account            @relation(fields: [ledgerAccountId], references: [id])
  transactions      BankTransaction[]
  vouchers          FinancialVoucher[]
  expenses          Expense[]
  revenues          Revenue[]
  outgoingTransfers BankTransfer[]     @relation("OutgoingBankTransfers")
  incomingTransfers BankTransfer[]     @relation("IncomingBankTransfers")
  employeeAdvances  EmployeeAdvance[]
  payrollPayments   PayrollPayment[]

  @@index([tenantId, companyId])
}

model BankTransaction {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1)
  companyId       Int      @default(1)
  bankAccountId   Int
  transactionDate DateTime @default(now())
  transactionType String
  amountIn        Decimal  @default(0)
  amountOut       Decimal  @default(0)
  balanceAfter    Decimal
  referenceType   String
  referenceId     Int
  referenceNumber String?
  description     String?
  createdAt       DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([bankAccountId, referenceType, referenceId])
  @@index([bankAccountId, transactionDate])
  @@index([tenantId, companyId])
}

model BankTransfer {
  id                Int       @id @default(autoincrement())
  tenantId          Int       @default(1)
  companyId         Int       @default(1)
  transferNumber    String    @unique
  transferDate      DateTime  @default(now())
  fromBankAccountId Int
  toBankAccountId   Int
  amount            Decimal
  fees              Decimal   @default(0)
  referenceNumber   String?
  description       String?
  status            String    @default("POSTED")
  journalEntryId    Int?      @unique
  postedAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())

  fromBankAccount BankAccount   @relation("OutgoingBankTransfers", fields: [fromBankAccountId], references: [id])
  toBankAccount   BankAccount   @relation("IncomingBankTransfers", fields: [toBankAccountId], references: [id])
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([transferDate])
  @@index([tenantId, companyId])
}

model FinancialVoucher {
  id              Int       @id @default(autoincrement())
  tenantId        Int       @default(1)
  companyId       Int       @default(1)
  voucherNumber   String    @unique
  voucherType     String
  voucherDate     DateTime  @default(now())
  partyId         Int?
  amount          Decimal
  paymentMethod   String
  bankAccountId   Int
  referenceNumber String?
  description     String?
  status          String    @default("DRAFT")
  journalEntryId  Int?      @unique
  postedAt        DateTime?
  cancelledAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  party        Party?              @relation(fields: [partyId], references: [id])
  bankAccount  BankAccount         @relation(fields: [bankAccountId], references: [id])
  journalEntry JournalEntry?       @relation(fields: [journalEntryId], references: [id])
  allocations  VoucherAllocation[]

  @@index([voucherDate])
  @@index([partyId])
  @@index([status])
  @@index([tenantId, companyId])
}

model VoucherAllocation {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @default(1)
  companyId  Int      @default(1)
  voucherId  Int
  saleId     Int?
  purchaseId Int?
  amount     Decimal
  createdAt  DateTime @default(now())

  voucher  FinancialVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  sale     Sale?            @relation(fields: [saleId], references: [id])
  purchase Purchase?        @relation(fields: [purchaseId], references: [id])

  @@unique([voucherId, saleId])
  @@unique([voucherId, purchaseId])
  @@index([saleId])
  @@index([purchaseId])
  @@index([tenantId, companyId])
}

// ============================================================
// GLOBAL SAAS CORE
// Tenant, organization, localization, entitlements and RBAC.
// Existing NETAj records are retained under the default company.
// ============================================================

model Tenant {
  id                  Int      @id @default(autoincrement())
  slug                String   @unique
  name                String
  status              String   @default("ACTIVE")
  defaultLanguageCode String   @default("ar")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  groups        CompanyGroup[]
  companies     Company[]
  memberships   TenantMembership[]
  roles         Role[]
  subscriptions TenantSubscription[]
}

model CompanyGroup {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  code      String
  nameAr    String
  nameEn    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  companies Company[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Company {
  id                   Int      @id @default(autoincrement())
  tenantId             Int
  groupId              Int?
  code                 String
  legalNameAr          String
  legalNameEn          String?
  tradeName            String?
  countryCode          String   @default("SA")
  baseCurrencyCode     String   @default("SAR")
  defaultLanguageCode  String   @default("ar")
  timeZoneName         String   @default("Asia/Riyadh")
  vatNumber            String?
  fiscalYearStartMonth Int      @default(1)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  group         CompanyGroup?         @relation(fields: [groupId], references: [id])
  country       Country               @relation(fields: [countryCode], references: [code])
  baseCurrency  Currency              @relation(fields: [baseCurrencyCode], references: [code])
  language      Language              @relation(fields: [defaultLanguageCode], references: [code])
  timeZone      TimeZone              @relation(fields: [timeZoneName], references: [name])
  branches      Branch[]
  warehouses    Warehouse[]
  departments   Department[]
  costCenters   CostCenter[]
  fiscalYears   FiscalYear[]
  exchangeRates ExchangeRate[]
  localizations CompanyLocalization[]
  modules       CompanyModule[]
  entitlements  CompanyEntitlement[]
  roles         Role[]
  userAccess    CompanyAccess[]
  sessions      AuthSession[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([groupId])
}

model Branch {
  id        Int      @id @default(autoincrement())
  companyId Int
  code      String
  nameAr    String
  nameEn    String?
  city      String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  companyId Int
  branchId  Int?
  code      String
  nameAr    String
  nameEn    String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
}

model Department {
  id        Int      @id @default(autoincrement())
  companyId Int
  parentId  Int?
  code      String
  nameAr    String
  nameEn    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id])
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentHierarchy")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
}

model FiscalYear {
  id        Int       @id @default(autoincrement())
  companyId Int
  name      String
  startDate DateTime
  endDate   DateTime
  status    String    @default("OPEN")
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  company Company        @relation(fields: [companyId], references: [id])
  periods FiscalPeriod[]

  @@unique([companyId, startDate, endDate])
  @@index([companyId, status])
}

model FiscalPeriod {
  id           Int       @id @default(autoincrement())
  fiscalYearId Int
  periodNumber Int
  name         String
  startDate    DateTime
  endDate      DateTime
  status       String    @default("OPEN")
  closedAt     DateTime?
  createdAt    DateTime  @default(now())

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id])

  @@unique([fiscalYearId, periodNumber])
  @@index([startDate, endDate])
}

model Currency {
  code          String   @id
  nameAr        String
  nameEn        String
  symbol        String?
  decimalPlaces Int      @default(2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  companies          Company[]
  baseExchangeRates  ExchangeRate[] @relation("BaseCurrency")
  quoteExchangeRates ExchangeRate[] @relation("QuoteCurrency")
}

model ExchangeRate {
  id                Int      @id @default(autoincrement())
  companyId         Int
  baseCurrencyCode  String
  quoteCurrencyCode String
  rateDate          DateTime
  rate              Decimal
  source            String?
  createdAt         DateTime @default(now())

  company       Company  @relation(fields: [companyId], references: [id])
  baseCurrency  Currency @relation("BaseCurrency", fields: [baseCurrencyCode], references: [code])
  quoteCurrency Currency @relation("QuoteCurrency", fields: [quoteCurrencyCode], references: [code])

  @@unique([companyId, baseCurrencyCode, quoteCurrencyCode, rateDate])
  @@index([companyId, rateDate])
}

model Language {
  code       String   @id
  name       String
  nativeName String
  direction  String   @default("LTR")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  companies Company[]
  packs     LocalizationPack[]
}

model Country {
  code                 String   @id
  nameAr               String
  nameEn               String
  defaultCurrencyCode  String?
  taxRegistrationLabel String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  companies Company[]
  packs     LocalizationPack[]
}

model TimeZone {
  name      String   @id
  label     String
  utcOffset String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  companies Company[]
}

model LocalizationPack {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  countryCode  String
  languageCode String
  version      Int      @default(1)
  configJson   String   @default("{}")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  country   Country               @relation(fields: [countryCode], references: [code])
  language  Language              @relation(fields: [languageCode], references: [code])
  companies CompanyLocalization[]

  @@index([countryCode, languageCode])
}

model CompanyLocalization {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  localizationPackId Int
  isPrimary          Boolean  @default(false)
  settingsJson       String   @default("{}")
  createdAt          DateTime @default(now())

  company          Company          @relation(fields: [companyId], references: [id])
  localizationPack LocalizationPack @relation(fields: [localizationPackId], references: [id])

  @@unique([companyId, localizationPackId])
  @@index([companyId])
}

model ModuleDefinition {
  key         String   @id
  nameAr      String
  nameEn      String
  description String?
  isCore      Boolean  @default(false)
  createdAt   DateTime @default(now())

  companies CompanyModule[]
  plans     PlanModule[]
}

model CompanyModule {
  id           Int      @id @default(autoincrement())
  companyId    Int
  moduleKey    String
  enabled      Boolean  @default(true)
  settingsJson String   @default("{}")
  updatedAt    DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id])
  module  ModuleDefinition @relation(fields: [moduleKey], references: [key])

  @@unique([companyId, moduleKey])
  @@index([companyId])
}

model EntitlementDefinition {
  key         String   @id
  name        String
  valueType   String   @default("BOOLEAN")
  description String?
  createdAt   DateTime @default(now())

  companies CompanyEntitlement[]
}

model CompanyEntitlement {
  id             Int       @id @default(autoincrement())
  companyId      Int
  entitlementKey String
  value          String
  source         String    @default("PLAN")
  expiresAt      DateTime?
  updatedAt      DateTime  @updatedAt

  company     Company               @relation(fields: [companyId], references: [id])
  entitlement EntitlementDefinition @relation(fields: [entitlementKey], references: [key])

  @@unique([companyId, entitlementKey])
  @@index([companyId])
}

model SubscriptionPlan {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  status       String   @default("ACTIVE")
  userLimit    Int?
  companyLimit Int?
  storageMb    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules       PlanModule[]
  subscriptions TenantSubscription[]
}

model PlanModule {
  id        Int     @id @default(autoincrement())
  planId    Int
  moduleKey String
  enabled   Boolean @default(true)

  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
  module ModuleDefinition @relation(fields: [moduleKey], references: [key])

  @@unique([planId, moduleKey])
}

model TenantSubscription {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  planId      Int
  status      String    @default("TRIAL")
  startsAt    DateTime  @default(now())
  trialEndsAt DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([tenantId, status])
}

model PlatformUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String?
  status       String   @default("ACTIVE")
  locale       String   @default("ar")
  mfaEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships TenantMembership[]
  sessions    AuthSession[]
}

model TenantMembership {
  id               Int      @id @default(autoincrement())
  tenantId         Int
  userId           Int
  defaultCompanyId Int?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  user      PlatformUser     @relation(fields: [userId], references: [id])
  roles     MembershipRole[]
  companies CompanyAccess[]
  sessions  AuthSession[]

  @@unique([tenantId, userId])
  @@index([userId])
}

model CompanyAccess {
  membershipId Int
  companyId    Int
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([membershipId, companyId])
  @@index([companyId])
}

model AuthSession {
  id           String    @id
  tokenHash    String    @unique
  userId       Int
  membershipId Int
  companyId    Int
  expiresAt    DateTime
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user       PlatformUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([membershipId, companyId])
  @@index([expiresAt, revokedAt])
}

model Role {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  companyId Int?
  code      String
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  company     Company?         @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId])
}

model Permission {
  key         String   @id
  moduleKey   String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([moduleKey])
}

model RolePermission {
  roleId        Int
  permissionKey String
  granted       Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
}

model MembershipRole {
  membershipId Int
  roleId       Int

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}
