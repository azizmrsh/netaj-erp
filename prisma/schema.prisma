// ============================================================
// DATA IMPORT AND LEGACY MIGRATION CENTER
// Uploaded source rows are retained with immutable provenance so
// every created ERP record can be traced to its file, sheet and row.
// ============================================================

model ImportBatch {
  id                Int       @id @default(autoincrement())
  tenantId          Int       @default(1)
  companyId         Int       @default(1)
  batchNumber       String    @unique
  targetType        String
  importMode        String    @default("FULL")
  duplicateStrategy String    @default("SKIP")
  sourceSystemId    Int?
  legacySystem      String    @default("GENERIC")
  sourceFile        String
  fileHash          String
  status            String    @default("PREVIEW")
  cutoverDate       DateTime?
  mappingJson       String    @default("{}")
  sheetsJson        String    @default("[]")
  summaryJson       String    @default("{}")
  impactJson        String    @default("{}")
  reconciliationJson String  @default("{}")
  totalRows         Int       @default(0)
  validRows         Int       @default(0)
  invalidRows       Int       @default(0)
  duplicateRows     Int       @default(0)
  warningRows       Int       @default(0)
  createdRows       Int       @default(0)
  updatedRows       Int       @default(0)
  skippedRows       Int       @default(0)
  createdBy         String?
  dryRunAt          DateTime?
  approvedAt        DateTime?
  approvedBy        String?
  executedAt        DateTime?
  rolledBackAt      DateTime?
  rollbackStatus    String    @default("AVAILABLE")
  rollbackBlockedReason String?
  failureReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company            @relation(fields: [companyId], references: [id])
  sourceSystem LegacySourceSystem? @relation(fields: [sourceSystemId], references: [id])
  rows    ImportRow[]
  links   LegacyRecordLink[]
  referenceSnapshots LegacyReferenceSnapshot[]

  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, companyId, status])
  @@index([fileHash, targetType])
  @@index([sourceSystemId, targetType])
}

model ImportRow {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @default(1)
  companyId      Int       @default(1)
  importBatchId  Int
  sourceSheet    String
  sourceRow      Int
  rawDataJson    String
  mappedDataJson String    @default("{}")
  status         String    @default("PENDING")
  errorsJson     String    @default("[]")
  warningsJson   String    @default("[]")
  duplicateKey   String?
  entityType     String?
  entityId       Int?
  operation      String?
  importedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  batch ImportBatch       @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  link  LegacyRecordLink?
  referenceSnapshot LegacyReferenceSnapshot?

  @@unique([importBatchId, sourceSheet, sourceRow])
  @@index([tenantId, companyId, status])
  @@index([entityType, entityId])
}

model LegacyRecordLink {
  id                   Int      @id @default(autoincrement())
  tenantId             Int      @default(1)
  companyId            Int      @default(1)
  importBatchId        Int
  importRowId          Int      @unique
  entityType           String
  entityId             Int
  legacySource         String
  legacySystem         String?
  legacyCode           String?
  legacyDocumentNumber String?
  sourceFile           String
  sourceSheet          String
  sourceRow            Int
  importedBy           String?
  importedAt           DateTime @default(now())
  wasCreated           Boolean  @default(true)
  beforeDataJson       String?

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  row   ImportRow   @relation(fields: [importRowId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, entityType, entityId, sourceRow])
  @@index([tenantId, companyId, entityType, entityId])
  @@index([legacySource, legacyDocumentNumber])
}

model ImportTemplate {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @default(1)
  companyId   Int      @default(1)
  targetType  String
  sourceSystemId Int?
  headerFingerprint String?
  name        String
  mappingJson String   @default("{}")
  isDefault   Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  sourceSystem LegacySourceSystem? @relation(fields: [sourceSystemId], references: [id])

  @@unique([tenantId, companyId, targetType, name])
  @@index([tenantId, companyId, targetType])
  @@index([sourceSystemId, targetType, headerFingerprint])
}

model LegacySourceSystem {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1)
  companyId       Int      @default(1)
  code            String
  name            String
  vendor          String?
  version         String?
  description     String?
  detectionJson   String   @default("{}")
  isActive        Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  batches         ImportBatch[]
  templates       ImportTemplate[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId, isActive])
}

model LegacyReferenceSnapshot {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @default(1)
  companyId      Int      @default(1)
  importBatchId  Int
  importRowId    Int      @unique
  reportType     String
  snapshotDate   DateTime?
  legacyCode     String?
  dataJson       String
  importedBy     String?
  importedAt     DateTime @default(now())

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  row   ImportRow   @relation(fields: [importRowId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId, reportType])
  @@index([importBatchId])
}

// ============================================================
// NO-CODE COMPANY CONFIGURATION AND CUSTOM REPORTS
// ============================================================

model CustomFieldDefinition {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @default(1)
  companyId      Int      @default(1)
  entityType     String
  fieldKey       String
  labelAr        String
  labelEn        String?
  fieldType      String
  required       Boolean  @default(false)
  visible        Boolean  @default(true)
  optionsJson    String   @default("[]")
  defaultValue   String?
  validationJson String   @default("{}")
  conditionJson  String   @default("{}")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company            @relation(fields: [companyId], references: [id])
  values  CustomFieldValue[]

  @@unique([tenantId, companyId, entityType, fieldKey])
  @@index([tenantId, companyId, entityType, isActive])
}

model CustomFieldValue {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @default(1)
  companyId  Int      @default(1)
  fieldId    Int
  entityType String
  entityId   Int
  valueJson  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company               @relation(fields: [companyId], references: [id])
  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityType, entityId])
  @@index([tenantId, companyId, entityType, entityId])
}

model CompanyConfiguration {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @default(1)
  companyId Int      @default(1)
  category  String
  configKey String
  labelAr   String?
  labelEn   String?
  valueType String   @default("JSON")
  valueJson String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([tenantId, companyId, category, configKey])
  @@index([tenantId, companyId, category, isActive])
}

model ApprovalRule {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @default(1)
  companyId     Int      @default(1)
  code          String
  name          String
  entityType    String
  conditionJson String   @default("{}")
  stepsJson     String   @default("[]")
  priority      Int      @default(100)
  isActive      Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId, entityType, isActive])
}

model CustomReportDefinition {
  id               Int      @id @default(autoincrement())
  tenantId         Int      @default(1)
  companyId        Int      @default(1)
  code             String
  name             String
  sourceType       String
  fieldsJson       String
  filtersJson      String   @default("[]")
  groupByJson      String   @default("[]")
  sortJson         String   @default("[]")
  calculationsJson String   @default("[]")
  visibility       String   @default("PRIVATE")
  ownerUserId      Int?
