  functionalAmountIn     Decimal  @default(0)
  functionalAmountOut    Decimal  @default(0)
  functionalBalanceAfter Decimal  @default(0)
  exchangeRate           Decimal  @default(1)
  referenceType          String
  referenceId            Int
  referenceNumber        String?
  description            String?
  createdAt              DateTime @default(now())

  bankAccount        BankAccount             @relation(fields: [bankAccountId], references: [id])
  reconciliationLine BankReconciliationLine?

  @@unique([bankAccountId, referenceType, referenceId])
  @@index([bankAccountId, transactionDate])
  @@index([tenantId, companyId])
}

model BankReconciliation {
  id        Int @id @default(autoincrement())
  tenantId  Int @default(1)
  companyId Int @default(1)

  reconciliationNumber       String    @unique
