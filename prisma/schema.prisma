// ============================================================
// DOCUMENT DESIGN, WHITE-LABEL THEME AND CONFIGURABLE DASHBOARDS
// Presentation definitions are versioned and remain separate from
// operational/accounting data. Issued documents retain an immutable snapshot.
// ============================================================

model DocumentTemplate {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @default(1)
  companyId    Int      @default(1)
  code         String
  name         String
  documentType String
  language     String   @default("AR")
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company                   @relation(fields: [companyId], references: [id])
  versions DocumentTemplateVersion[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId, documentType, isActive])
}

model DocumentTemplateVersion {
  id          Int       @id @default(autoincrement())
  templateId  Int
  version     Int
  status      String    @default("DRAFT")
  designJson  String
  changeNotes String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  template        DocumentTemplate             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  issuedDocuments IssuedDocumentPresentation[]

  @@unique([templateId, version])
  @@index([templateId, status])
}

model IssuedDocumentPresentation {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @default(1)
  companyId         Int      @default(1)
  entityType        String
  entityId          Int
  documentNumber    String?
  issueDate         DateTime @default(now())
  templateVersionId Int
  dataSnapshotJson  String
  checksum          String
  createdBy         String?
  createdAt         DateTime @default(now())

  company         Company                 @relation(fields: [companyId], references: [id])
  templateVersion DocumentTemplateVersion @relation(fields: [templateVersionId], references: [id])

  @@unique([tenantId, companyId, entityType, entityId])
  @@index([tenantId, companyId, documentNumber])
}

model CompanyThemeProfile {
